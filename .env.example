# -------------------------------------------------------------
# Legal Analyzer: Docker Deployment Environment Configuration
# -------------------------------------------------------------
# Instructions:
# 1. Copy this file to `.env` inside `la-legpro-be/`
# 2. Fill in the values before running `docker-compose up -d`

# === Authentication ===
# MUST BE SECURE FOR PRODUCTION! (e.g., generate via `openssl rand -hex 32`)
JWT_SECRET=

# === LLM API Configuration ===
# Base URL of your chosen LLM provider (must be OpenAI compatible)
MODEL_BASE_URL=https://console.labahasa.ai/v1

# API Key for the LLM
MODEL_API_KEY=

# LLM Model Name to use
LLAMA_MODEL=llama-4-maverick-instruct

# === Retry & Stability ===
GLM_MAX_ATTEMPTS=5
GLM_RETRY_BACKOFF_BASE=0.8

# === Frontend Configuration ===
# For local Docker Compose development, the frontend will be accessible at http://localhost:5173
# The backend is accessible from the host at http://localhost:8000
VITE_API_URL=http://localhost:8000