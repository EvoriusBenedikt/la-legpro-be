# -------------------------------------------------------------
# Legal Analyzer: Docker Deployment Environment Configuration
# -------------------------------------------------------------
# Instructions:
# 1. Copy this file to `.env` inside `la-legpro-be/`
# 2. Fill in the values before running `docker compose up -d`
# 3. docker-compose.yml bind-mounts this file (./.env:/app/.env);
#    edits take effect after a container restart (`docker compose up -d`).

# === Authentication ===
# MUST BE SECURE FOR PRODUCTION! (e.g., generate via `openssl rand -hex 32`)
# The backend refuses to start when this is empty (fail-fast in api/auth.py).
JWT_SECRET=

# === LLM API Configuration ===
# Base URL of your chosen LLM provider (must be OpenAI compatible)
MODEL_BASE_URL=https://console.labahasa.ai/v1

# API Key for the LLM
MODEL_API_KEY=

# LLM Model Name to use (used for both text and vision calls)
LLAMA_MODEL=llama-4-maverick-instruct

# Embedder + reranker model locations. huggingface.co is unreachable from
# this network, so docker-compose.yml hard-codes the vendored weights under
# ./data/models (EMBEDDER_MODEL_NAME=/app/data/models/all-MiniLM-L6-v2,
# RERANKER_MODEL_NAME=/app/data/models/ms-marco-MiniLM-L-6-v2). The container
# environment wins over this file (load_dotenv does not override), so values
# here only matter for out-of-container runs.
# EMBEDDER_MODEL_NAME=all-MiniLM-L6-v2
# RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# === Retry & Stability ===
GLM_MAX_ATTEMPTS=5
GLM_RETRY_BACKOFF_BASE=0.8

# === CORS ===
# Comma-separated list of origins allowed to call the API (no wildcard when credentials are used)
# Keep the localhost entries only if you also run the frontend locally (`npm run dev` → :5173)
ALLOWED_ORIGINS=https://legal-analyzer.lintasarta.dev,http://localhost:5173,http://localhost:3000,http://localhost

# === Email alerts (optional — leave user/pass empty to disable) ===
# DECISION 2026-09-23: intentionally kept DISABLED for now (empty credentials =
# alerts skip with a log warning). Configure for real production use later.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_RECIPIENT_EMAIL=

# === Database (PostgreSQL 16 + pgvector) ===
# Migrations M1-M4 replaced the legacy SQLite DBs + ChromaDB with a single
# PostgreSQL database: compose service `postgres` (image pgvector/pgvector:pg16,
# data in the `pg_data` volume, loopback-only port 5432). docker-compose.yml
# interpolates this password into both the postgres service and the backend's
# DATABASE_URL (postgresql://legpro:<POSTGRES_PASSWORD>@postgres:5432/legpro).
# MUST BE SET for any real deployment (compose falls back to insecure `legpro`).
POSTGRES_PASSWORD=

# Optional override for special setups only. In-container code always gets
# DATABASE_URL from docker-compose.yml; host-run scripts build a loopback URL
# from POSTGRES_PASSWORD via script_env.py when DATABASE_URL is unset.
# DATABASE_URL=postgresql://legpro:secret@127.0.0.1:5432/legpro

# === Storage ===
# Uploaded PDFs, the vendored model weights (data/models/) and PG backup tars
# (legpro_backup_<ts>.tar) live under ./data, bind-mounted by docker-compose.yml
# (./data:/app/data) so they persist on the host across container rebuilds.
# The legacy SQLite files remain there until the migration is signed off (M5);
# the legacy ChromaDB directories were deleted in M4. Neither .env nor data/
# is tracked in git.

# === Frontend (NOT consumed by the backend) ===
# VITE_API_URL is a FRONTEND build arg (la-legpro-fe/docker-compose.yml → Dockerfile
# ARG), baked into the browser bundle at build time. Set it over there, e.g.:
#   VITE_API_URL=https://legal-analyzer.lintasarta.dev docker compose up -d --build
# It is documented here only so nobody adds it to this file expecting the
# backend to read it.
